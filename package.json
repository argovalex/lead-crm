{
  "name": "lead-crm",
  "version": "1.0.0",
  "description": "Self-hosted CRM: leads, pipeline, email sequences, tracking",
  "main": "src/server.js",
  "scripts": {
    "start": "prisma migrate deploy && node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "prisma migrate reset --force --skip-seed && node --test --test-concurrency=1 test/*.test.js",
    "hash-password": "node scripts/hash-password.js",
    "postinstall": "prisma generate"
  },
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cookie-session": "^2.1.1",
    "csv-parse": "^7.0.3",
    "express": "^4.22.3",
    "mailparser": "^3.7.2",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "resend": "^6.37.0",
    "svix": "^2.9.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
