# --- Required ---
# Railway: set to ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:pass@host:5432/crm
# Public URL of the app (used in unsubscribe links)
APP_URL=https://your-app.up.railway.app
ADMIN_EMAIL=you@example.com
# Login password: set ADMIN_PASSWORD (plain), or ADMIN_PASSWORD_HASH (bcrypt: npm run hash-password -- "pw")
ADMIN_PASSWORD=
# Generate with: openssl rand -hex 32
SESSION_SECRET=
RESEND_API_KEY=re_xxx
# Must be on a domain verified in Resend
EMAIL_FROM="Your Name <hello@yourdomain.com>"
EMAIL_REPLY_TO="alex@alargov.com"
# Resend → Webhooks → signing secret
WEBHOOK_SECRET=whsec_xxx

# --- Optional ---
NODE_ENV=production
# Max emails per UTC day
DAILY_SEND_CAP=200
SENDS_PER_MINUTE=10
# Flag open leads with no activity for N days
STALE_DAYS=14
SCHEDULER_ENABLED=true
# "mock" = no real sending (local dev)
EMAIL_PROVIDER=resend
