generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Stage {
  NEW
  CONTACTED
  ENGAGED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  STOPPED
}

enum MessageStatus {
  DRAFT
  QUEUED
  SENDING
  SENT
  FAILED
  CANCELLED
}

model Lead {
  id             Int          @id @default(autoincrement())
  name           String
  email          String       @unique
  phone          String?
  company        String?
  source         String?
  tags           String[]     @default([])
  notes          String?
  owner          String?
  country        String?
  segment        String?
  priority       String?
  website        String?
  nextAction     String?
  nextFollowUpAt DateTime?
  stage          Stage        @default(NEW)
  unsubscribed   Boolean      @default(false)
  unsubToken     String       @unique
  bounced        Boolean      @default(false)
  replied        Boolean      @default(false)
  stale          Boolean      @default(false)
  lastActivityAt DateTime     @default(now())
  createdAt      DateTime     @default(now())
  activities     Activity[]
  enrollments    Enrollment[]
  messages       EmailMessage[]

  @@index([stage])
  @@index([lastActivityAt])
  @@index([nextFollowUpAt])
}

model Activity {
  id        Int      @id @default(autoincrement())
  leadId    Int
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  data      Json?
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
  @@index([type])
}

model Sequence {
  id          Int            @id @default(autoincrement())
  name        String
  steps       SequenceStep[]
  enrollments Enrollment[]
  createdAt   DateTime       @default(now())
}

model SequenceStep {
  id         Int      @id @default(autoincrement())
  sequenceId Int
  sequence   Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  index      Int
  delayDays  Int
  subject    String
  body       String

  @@unique([sequenceId, index])
}

model Enrollment {
  id            Int              @id @default(autoincrement())
  leadId        Int
  lead          Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sequenceId    Int
  sequence      Sequence         @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  status        EnrollmentStatus @default(ACTIVE)
  stopReason    String?
  nextStepIndex Int              @default(0)
  nextRunAt     DateTime?
  startedAt     DateTime         @default(now())
  messages      EmailMessage[]

  @@unique([leadId, sequenceId])
  @@index([status, nextRunAt])
}

model EmailMessage {
  id             Int           @id @default(autoincrement())
  leadId         Int
  lead           Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  enrollmentId   Int?
  enrollment     Enrollment?   @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  stepIndex      Int?
  idempotencyKey String        @unique
  subject        String
  body           String
  status         MessageStatus @default(QUEUED)
  attempts       Int           @default(0)
  lastError      String?
  lockedAt       DateTime?
  providerId     String?       @unique
  createdAt      DateTime      @default(now())
  sentAt         DateTime?
  deliveredAt    DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  bouncedAt      DateTime?

  @@index([status, createdAt])
  @@index([sentAt])
}

model WebhookEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

// GMDSS outreach campaign leads (separate from Lead). Case-insensitive unique indexes live in the migration SQL.
model GmdssLead {
  id            Int       @id @default(autoincrement())
  organization  String
  country       String?
  segment       String?
  productFit    String?   @map("product_fit")
  whyTheydBuy   String?   @map("why_theyd_buy")
  website       String?
  email         String?
  phone         String?
  priority      String?
  emailStatus   String    @default("not_sent") @map("email_status")
  lastEmailedAt DateTime? @map("last_emailed_at")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")
  templateId    Int?      @map("template_id")
  template      GmdssTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  providerId    String?   @unique @map("provider_id")
  deliveredAt   DateTime? @map("delivered_at")
  openedAt      DateTime? @map("opened_at")
  clickedAt     DateTime? @map("clicked_at")
  bouncedAt     DateTime? @map("bounced_at")
  lastClickLink String?   @map("last_click_link")
  openCount     Int       @default(0) @map("open_count")
  clickCount    Int       @default(0) @map("click_count")
  notes         String?
  followUpAt    DateTime? @map("follow_up_at")
  repliedAt     DateTime? @map("replied_at")
  reminderCount Int       @default(0) @map("reminder_count")
  lastReminderAt DateTime? @map("last_reminder_at")
  codeSentAt    DateTime? @map("code_sent_at")
  accessCode    String?   @map("access_code")
  closedAt      DateTime? @map("closed_at")
  activities    GmdssActivity[]

  @@map("gmdss_leads")
}

model GmdssTemplate {
  id        Int         @id @default(autoincrement())
  name      String
  subject   String
  body      String
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at")
  leads     GmdssLead[]

  @@map("gmdss_templates")
}

model GmdssActivity {
  id        Int       @id @default(autoincrement())
  leadId    Int       @map("lead_id")
  lead      GmdssLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  detail    String?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([leadId, createdAt])
  @@map("gmdss_activities")
}
